# ── Mode A: hosted environment ────────────────────────────────────────
# The SDK reads <root>/env.js and derives everything else from it.
# VITE_UNIFY_ENVIRONMENT_URL=https://your-environment.unify.cloud

# ── Mode B: sandbox / per-developer stack ─────────────────────────────
# No env.js is published, so supply the settings directly. These are the
# same values the main Unify app keeps in environment.development.ts.
VITE_UNIFY_GRAPHQL_URL=https://<stack>-api.<stack>.sandbox.bizzdesign.dev/graphql
VITE_UNIFY_GRAPHQL_REALTIME_URL=wss://<id>.appsync-realtime-api.<region>.amazonaws.com/graphql/realtime
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_DOMAIN=<stack>-auth.<stack>.sandbox.bizzdesign.dev/
VITE_COGNITO_USER_POOL_ID=<user-pool-id>
VITE_COGNITO_CLIENT_ID=<app-client-id>

# Optional. Defaults to this app's own origin. Only set it if you are serving
# the app AT that origin — Cognito redirects there, so it must be where the app
# actually lives.
# VITE_UNIFY_CALLBACK_URL=http://localhost:4204

# 'BDCore' (default) or 'ArchiMate'. Must match the environment's metamodel.
VITE_UNIFY_METAMODEL=BDCore
