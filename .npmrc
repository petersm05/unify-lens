@bizzdesign:registry=https://npm.pkg.github.com/

# Auth is deliberately not committed here.
#   Local:  your ~/.npmrc already holds the GitHub Packages token.
#   CI:     export GITHUB_PACKAGES_TOKEN and append the line below, or use
#           actions/setup-node with `registry-url` + NODE_AUTH_TOKEN.
# //npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
