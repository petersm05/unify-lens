# A production build is tenant-neutral on purpose.
#
# .env holds a developer's own environment so `npm run dev` just works. Vite
# also loads it for `npm run build`, which would bake that tenant into the
# artifact — one build per customer, and a public deploy pointing at someone's
# sandbox. Blanking the variables here (this file wins in production) makes the
# built app ask on first run instead; an empty value reads as "not set".
#
# A specific deployment is still pinned by dropping a config.json beside the
# built files, which is read at runtime rather than baked in.
VITE_UNIFY_ENVIRONMENT_URL=
VITE_UNIFY_GRAPHQL_URL=
VITE_UNIFY_GRAPHQL_REALTIME_URL=
VITE_COGNITO_REGION=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_UNIFY_METAMODEL=
VITE_UNIFY_CALLBACK_URL=
